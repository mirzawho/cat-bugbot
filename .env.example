# توکن ربات را از @BotFather بگیرید و مقدار واقعی را فقط در .env قرار دهید
BOT_TOKEN=

# مسیر فایل دیتابیس SQLite
DATABASE_PATH=./data/bugbot.db

# آدرس سرور Health (فقط برای probe؛ پورت لازم نیست به بیرون منتشر شود)
HEALTH_ADDR=:8080

# ریشه سرور Bot API. ربات به <base>/bot<TOKEN>/getUpdates درخواست می‌فرستد،
# پس فقط آدرسی بگذارید که واقعاً همان API تلگرام (یا پروکسی/آینه آن) باشد.
TELEGRAM_API_BASE=https://api.telegram.org

# (اختیاری، توصیه می‌شود) شناسه گروهِ آرشیو که فایل‌های گزارش به آن دوباره ارسال می‌شوند.
# با این کار file_idهای مدیا همیشه برای ربات فعلی معتبر می‌مانند و پنل می‌تواند آن‌ها را نشان دهد.
# ربات را به عنوان ادمین در گروه اضافه کنید (یا از شناسه چت خودِ مدیر} استفاده کنید).
REPORT_CHAT_ID=

# مدیران: شناسه‌های عددی تلگرام، جدا شده با کاما (از @userinfobot بگیرید)
ADMINS=
# رمز ورود پنل مدیریت در /admin/
ADMIN_PANEL_PASSWORD=

# (اختیاری) آدرس عمومی سرویس، برای Secure Cookie هنگام استفاده پشت HTTPS
SERVICE_URL=
# (اختیاری) محدودکردن کل پنل به IPهای edge خودتان. با true شدن، هدر x-cat-user-id
# فقط از همین IPها پذیرفته می‌شود؛ پس edge باید این هدرها را از کلاینت حذف کند.
ADMIN_PANEL_IP_ALLOWLIST_ENFORCED=false
ADMIN_PANEL_ALLOWED_IPS=
